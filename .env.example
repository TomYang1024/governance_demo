# 复制为 .env，然后在等号后填入真实密钥；.env 已在 .gitignore 中排除。
# 显式加载：.venv/bin/python example_live_model.py --env-file .env
DEEPSEEK_API_KEY=

# 也可删除上面的变量，改用保存密钥的文件（两种方式选择一种）：
# DEEPSEEK_API_KEY_FILE=/绝对路径/deepseek-api-key.txt

GOVERNANCE_DEMO_PROVIDER=deepseek
GOVERNANCE_DEMO_MODEL=deepseek-flash

# 官方地址是 SDK 的默认值；需要自定义兼容端点时再设置：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
